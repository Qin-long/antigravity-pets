    "scrollbarSlider.activeBackground": "#FF6B2B99",

    "gitDecoration.addedResourceForeground": "#2DD4BF",
    "gitDecoration.modifiedResourceForeground": "#FF6B2B",
    "gitDecoration.deletedResourceForeground": "#FB7185",
    "gitDecoration.untrackedResourceForeground": "#FBBF24",
    "gitDecoration.ignoredResourceForeground": "#6B5147",
    "gitDecoration.conflictingResourceForeground": "#EF4444"
  },
  "semanticTokenColors": {
    "class": "#2DD4BF",
    "interface": "#5EEAD4",
    "type": "#2DD4BF",
    "typeParameter": "#99F6E4",
    "enum": "#38BDF8",
    "function": "#FF8A4C",
    "method": "#FDBA74",
    "property": "#FED7AA",
    "variable.readonly": "#FBBF24",
    "parameter": { "foreground": "#FDE68A", "italic": true },
    "decorator": "#2DD4BF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7D6358", "fontStyle": "italic" }
    },
    {
      "name": "Docstrings",
      "scope": ["comment.block.documentation", "string.quoted.docstring"],
      "settings": { "foreground": "#997B6E", "fontStyle": "italic" }
    },
    {
      "name": "Strings — Solar Gold",
      "scope": ["string", "punctuation.definition.string", "constant.other.symbol"],
      "settings": { "foreground": "#FBBF24" }
    },
    {
      "name": "Regex & Escape Chars",
      "scope": ["constant.character.escape", "string.regexp", "punctuation.section.embedded"],
      "settings": { "foreground": "#2DD4BF" }
    },
    {
      "name": "Numbers & Constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": { "foreground": "#FB7185" }
    },
    {
      "name": "Keywords & Storage — Flare Orange-Red",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#FF6B2B", "fontStyle": "bold" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#5EEAD4" }
    },
    {
      "name": "Functions & Methods — Flame Amber",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#FB923C" }
    },
    {
      "name": "Classes, Types & Interfaces — Wing Teal",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#2DD4BF" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#FFF7ED" }
    },
    {
      "name": "Function Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#FED7AA", "fontStyle": "italic" }
    },
    {
      "name": "Language Variables",
      "scope": ["variable.language"],
      "settings": { "foreground": "#FB7185", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name.css"],
      "settings": { "foreground": "#FDBA74" }
    },
    {
      "name": "HTML / JSX Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#FF6B2B" }
    },
    {
      "name": "HTML / JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#2DD4BF", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#2DD4BF" }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#FB923C" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#FF6B2B", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FBBF24", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#5EEAD4", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Inline Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#2DD4BF" }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link.title.markdown"],
      "settings": { "foreground": "#2DD4BF" }
    }
  ]
}

