    "gitDecoration.untrackedResourceForeground": "#38BDF8",
    "gitDecoration.ignoredResourceForeground": "#564779",
    "gitDecoration.conflictingResourceForeground": "#FB923C"
  },
  "semanticTokenColors": {
    "class": "#67E8F9",
    "interface": "#A5F3FC",
    "type": "#38BDF8",
    "typeParameter": "#C084FC",
    "enum": "#2DD4BF",
    "function": "#C084FC",
    "method": "#D8B4FE",
    "property": "#DDD6FE",
    "variable.readonly": "#FDA4AF",
    "parameter": { "foreground": "#E9D5FF", "italic": true },
    "decorator": "#F43F5E"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6E5F92", "fontStyle": "italic" }
    },
    {
      "name": "Docstrings",
      "scope": ["comment.block.documentation", "string.quoted.docstring"],
      "settings": { "foreground": "#8776B0", "fontStyle": "italic" }
    },
    {
      "name": "Strings — Eerie Ghost Mint / Ectoplasm",
      "scope": ["string", "punctuation.definition.string", "constant.other.symbol"],
      "settings": { "foreground": "#5EEAD4" }
    },
    {
      "name": "Regex & Escape Sequences",
      "scope": ["constant.character.escape", "string.regexp", "punctuation.section.embedded"],
      "settings": { "foreground": "#F43F5E" }
    },
    {
      "name": "Numbers, Booleans, Constants — Crimson Eye",
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": { "foreground": "#FB7185" }
    },
    {
      "name": "Keywords & Storage — Crimson Eye & Shadow",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#F43F5E", "fontStyle": "bold" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#E879F9" }
    },
    {
      "name": "Functions & Methods — Spectral Violet",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#C084FC" }
    },
    {
      "name": "Classes, Types & Interfaces — Phantom Cyan",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#67E8F9" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#EDE9FE" }
    },
    {
      "name": "Function Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#FBCFE8", "fontStyle": "italic" }
    },
    {
      "name": "Language Variables",
      "scope": ["variable.language"],
      "settings": { "foreground": "#F43F5E", "fontStyle": "italic" }
    },
    {
      "name": "Object Properties",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name.css"],
      "settings": { "foreground": "#C4B5FD" }
    },
    {
      "name": "HTML / JSX Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#F43F5E" }
    },
    {
      "name": "HTML / JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#C084FC", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#FBBF24" }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#C084FC" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#C084FC", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#F43F5E", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#D8B4FE", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Inline Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#5EEAD4" }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link.title.markdown"],
      "settings": { "foreground": "#67E8F9" }
    }
  ]
}

