    "statusBar.noFolderBackground": "#111827",
    "statusBarItem.hoverBackground": "#FACC1526",
    "statusBarItem.prominentBackground": "#FACC152E",
    "statusBarItem.prominentForeground": "#FEF9C3",
    "statusBarItem.remoteBackground": "#FACC15",
    "statusBarItem.remoteForeground": "#0B0F19",

    "panel.background": "#080C14",
    "panel.border": "#1B253B",
    "panelTitle.activeBorder": "#FACC15",
    "panelTitle.activeForeground": "#FACC15",
    "panelTitle.inactiveForeground": "#7F91B0",

    "terminal.background": "#080C14",
    "terminal.foreground": "#E2E8F0",
    "terminalCursor.foreground": "#FACC15",
    "terminal.selectionBackground": "#60A5FA38",
    "terminal.ansiBlack": "#111827",
    "terminal.ansiRed": "#EF4444",
    "terminal.ansiGreen": "#34D399",
    "terminal.ansiYellow": "#FACC15",
    "terminal.ansiBlue": "#60A5FA",
    "terminal.ansiMagenta": "#C084FC",
    "terminal.ansiCyan": "#38BDF8",
    "terminal.ansiWhite": "#E2E8F0",
    "terminal.ansiBrightBlack": "#64748B",
    "terminal.ansiBrightRed": "#F87171",
    "terminal.ansiBrightGreen": "#6EE7B7",
    "terminal.ansiBrightYellow": "#FEF08A",
    "terminal.ansiBrightBlue": "#93C5FD",
    "terminal.ansiBrightMagenta": "#D8B4FE",
    "terminal.ansiBrightCyan": "#7DD3FC",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "chat.requestBackground": "#11192B",
    "chat.requestBorder": "#60A5FA44",
    "chat.slashCommandBackground": "#FACC1529",
    "chat.slashCommandForeground": "#FACC15",
