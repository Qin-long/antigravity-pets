    "button.background": "#FACC15",
    "button.foreground": "#0B0F19",
    "button.hoverBackground": "#FDE047",
    "button.secondaryBackground": "#1B253B",
    "button.secondaryForeground": "#F1F5F9",
    "button.secondaryHoverBackground": "#263552",

    "badge.background": "#FACC15",
    "badge.foreground": "#0B0F19",

    "input.background": "#060910",
    "input.foreground": "#F1F5F9",
    "input.border": "#23314D",
    "input.placeholderForeground": "#52627A",
    "inputOption.activeBackground": "#FACC1530",
    "inputOption.activeBorder": "#FACC15",
    "inputOption.activeForeground": "#FEF9C3",

    "dropdown.background": "#0F1624",
    "dropdown.foreground": "#F1F5F9",
    "dropdown.border": "#23314D",

    "quickInput.background": "#0F1624",
    "quickInput.foreground": "#E2E8F0",
    "quickInputList.focusBackground": "#60A5FA2E",
    "quickInputList.focusForeground": "#FFFFFF",
    "pickerGroup.border": "#23314D",
    "pickerGroup.foreground": "#FACC15",

    "notificationCenterHeader.background": "#111827",
    "notificationCenterHeader.foreground": "#FACC15",
    "notifications.background": "#0F1624",
    "notifications.foreground": "#E2E8F0",
    "notifications.border": "#60A5FA55",
    "notificationLink.foreground": "#60A5FA",

    "progressBar.background": "#FACC15",
    "scrollbar.shadow": "#00000088",
    "scrollbarSlider.background": "#41506B4D",
    "scrollbarSlider.hoverBackground": "#60A5FA66",
    "scrollbarSlider.activeBackground": "#FACC1599",

    "gitDecoration.addedResourceForeground": "#34D399",
    "gitDecoration.modifiedResourceForeground": "#FACC15",
    "gitDecoration.deletedResourceForeground": "#F87171",
    "gitDecoration.untrackedResourceForeground": "#60A5FA",
    "gitDecoration.ignoredResourceForeground": "#475569",
    "gitDecoration.conflictingResourceForeground": "#FB923C"
  },
  "semanticTokenColors": {
    "class": "#FACC15",
    "interface": "#FDE047",
    "type": "#FACC15",
    "typeParameter": "#93C5FD",
    "enum": "#38BDF8",
    "function": "#60A5FA",
    "method": "#93C5FD",
    "property": "#CBD5E1",
    "variable.readonly": "#F87171",
    "parameter": { "foreground": "#BAE6FD", "italic": true },
    "decorator": "#FACC15"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#596B87", "fontStyle": "italic" }
    },
    {
      "name": "Docstrings",
      "scope": ["comment.block.documentation", "string.quoted.docstring"],
      "settings": { "foreground": "#7387A6", "fontStyle": "italic" }
    },
    {
      "name": "Strings — Starlight Teal-Blue",
      "scope": ["string", "punctuation.definition.string", "constant.other.symbol"],
      "settings": { "foreground": "#67E8F9" }
    },
    {
      "name": "Regex & Escape Chars",
      "scope": ["constant.character.escape", "string.regexp", "punctuation.section.embedded"],
      "settings": { "foreground": "#F87171" }
    },
    {
      "name": "Numbers & Constants — Ruby",
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": { "foreground": "#F87171" }
    },
    {
      "name": "Keywords & Storage — Moonlight Indigo-Blue",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#818CF8", "fontStyle": "bold" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#93C5FD" }
    },
    {
      "name": "Functions & Methods — Moonlight Blue",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#60A5FA" }
    },
    {
      "name": "Classes, Types & Interfaces — Lunar Ring Gold",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#FACC15" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#E2E8F0" }
    },
    {
      "name": "Function Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#BAE6FD", "fontStyle": "italic" }
    },
    {
      "name": "Language Variables",
      "scope": ["variable.language"],
      "settings": { "foreground": "#F87171", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name.css"],
      "settings": { "foreground": "#BFDBFE" }
    },
    {
      "name": "HTML / JSX Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#60A5FA" }
    },
    {
      "name": "HTML / JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FACC15", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#FACC15" }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#60A5FA" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#FACC15", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#93C5FD", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#C7D2FE", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Inline Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#67E8F9" }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link.title.markdown"],
      "settings": { "foreground": "#60A5FA" }
    }
  ]
}

