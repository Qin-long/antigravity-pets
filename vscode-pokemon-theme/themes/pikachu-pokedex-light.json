    "sideBarTitle.foreground": "#DC2626",
    "sideBarSectionHeader.background": "#E8EFF8",
    "sideBarSectionHeader.foreground": "#0F172A",
    "sideBarSectionHeader.border": "#CBD5E1",

    "list.activeSelectionBackground": "#0EA5E924",
    "list.activeSelectionForeground": "#0F172A",
    "list.activeSelectionIconForeground": "#EF4444",
    "list.inactiveSelectionBackground": "#E2E8F0B3",
    "list.inactiveSelectionForeground": "#1E293B",
    "list.hoverBackground": "#E8F1FA",
    "list.hoverForeground": "#0F172A",
    "list.focusBackground": "#0EA5E92E",
    "list.highlightForeground": "#DC2626",
    "list.errorForeground": "#DC2626",
    "list.warningForeground": "#D97706",
    "tree.indentGuidesStroke": "#CBD5E1",

    "editor.background": "#FFFFFF",
    "editor.foreground": "#1E293B",
