    "button.secondaryBackground": "#26203B",
    "button.secondaryForeground": "#F5F0FF",
    "button.secondaryHoverBackground": "#352C52",

    "badge.background": "#D946EF",
    "badge.foreground": "#FFFFFF",

    "input.background": "#0B0812",
    "input.foreground": "#F5F0FF",
    "input.border": "#342A52",
    "input.placeholderForeground": "#6E6388",
    "inputOption.activeBackground": "#D946EF38",
    "inputOption.activeBorder": "#D946EF",
    "inputOption.activeForeground": "#FFFFFF",

    "dropdown.background": "#181328",
    "dropdown.foreground": "#F5F0FF",
    "dropdown.border": "#342A52",

    "quickInput.background": "#181328",
    "quickInput.foreground": "#F3EEFA",
    "quickInputList.focusBackground": "#D946EF33",
    "quickInputList.focusForeground": "#FFFFFF",
    "pickerGroup.border": "#342A52",
    "pickerGroup.foreground": "#E879F9",

    "notificationCenterHeader.background": "#1D1730",
    "notificationCenterHeader.foreground": "#F0ABFC",
    "notifications.background": "#181328",
    "notifications.foreground": "#F3EEFA",
    "notifications.border": "#D946EF66",
    "notificationLink.foreground": "#818CF8",

    "progressBar.background": "#D946EF",
    "scrollbar.shadow": "#00000088",
    "scrollbarSlider.background": "#594E754D",
    "scrollbarSlider.hoverBackground": "#D946EF66",
    "scrollbarSlider.activeBackground": "#E879F999",

    "gitDecoration.addedResourceForeground": "#34D399",
    "gitDecoration.modifiedResourceForeground": "#E879F9",
    "gitDecoration.deletedResourceForeground": "#FB7185",
    "gitDecoration.untrackedResourceForeground": "#818CF8",
    "gitDecoration.ignoredResourceForeground": "#594E75",
    "gitDecoration.conflictingResourceForeground": "#FBBF24"
  },
  "semanticTokenColors": {
    "class": "#818CF8",
    "interface": "#A5B4FC",
    "type": "#38BDF8",
    "typeParameter": "#E879F9",
    "enum": "#2DD4BF",
    "function": "#E879F9",
    "method": "#F0ABFC",
    "property": "#E2D9F3",
    "variable.readonly": "#F9A8D4",
    "parameter": { "foreground": "#DDD6FE", "italic": true },
    "decorator": "#D946EF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#736691", "fontStyle": "italic" }
    },
    {
      "name": "Docstrings",
      "scope": ["comment.block.documentation", "string.quoted.docstring"],
      "settings": { "foreground": "#8E80AE", "fontStyle": "italic" }
    },
    {
      "name": "Strings — Telekinetic Cyan-Mint",
      "scope": ["string", "punctuation.definition.string", "constant.other.symbol"],
      "settings": { "foreground": "#67E8F9" }
    },
    {
      "name": "Regex & Escape Sequences",
      "scope": ["constant.character.escape", "string.regexp", "punctuation.section.embedded"],
      "settings": { "foreground": "#F472B6" }
    },
    {
      "name": "Numbers, Booleans, Constants — Psychic Rose",
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant"],
      "settings": { "foreground": "#F9A8D4" }
    },
    {
      "name": "Keywords & Storage — Psychic Magenta",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#D946EF", "fontStyle": "bold" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor"],
      "settings": { "foreground": "#C4B5FD" }
    },
    {
      "name": "Functions & Methods — Psychic Orchid",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#E879F9" }
    },
    {
      "name": "Classes, Types & Interfaces — Telekinetic Indigo-Blue",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#818CF8" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": { "foreground": "#F3EEFA" }
    },
    {
      "name": "Function Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#DDD6FE", "fontStyle": "italic" }
    },
    {
      "name": "Language Variables",
      "scope": ["variable.language"],
      "settings": { "foreground": "#F472B6", "fontStyle": "italic" }
    },
    {
      "name": "Object Properties",
      "scope": ["variable.other.property", "meta.object-literal.key", "support.type.property-name.css"],
      "settings": { "foreground": "#C7D2FE" }
    },
    {
      "name": "HTML / JSX Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#D946EF" }
    },
    {
      "name": "HTML / JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#A5B4FC", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#F0ABFC" }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#E879F9" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#E879F9", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#F0ABFC", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#A5B4FC", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Inline Code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#67E8F9" }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link.title.markdown"],
      "settings": { "foreground": "#818CF8" }
    }
  ]
}

