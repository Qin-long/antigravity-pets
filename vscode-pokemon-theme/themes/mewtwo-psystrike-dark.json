    "panelTitle.activeBorder": "#D946EF",
    "panelTitle.activeForeground": "#F0ABFC",
    "panelTitle.inactiveForeground": "#9588B5",

    "terminal.background": "#0E0B17",
    "terminal.foreground": "#F3EEFA",
    "terminalCursor.foreground": "#D946EF",
    "terminal.selectionBackground": "#D946EF3B",
    "terminal.ansiBlack": "#1D1730",
    "terminal.ansiRed": "#FB7185",
    "terminal.ansiGreen": "#34D399",
    "terminal.ansiYellow": "#FBBF24",
    "terminal.ansiBlue": "#818CF8",
    "terminal.ansiMagenta": "#D946EF",
    "terminal.ansiCyan": "#38BDF8",
    "terminal.ansiWhite": "#E2D9F3",
    "terminal.ansiBrightBlack": "#6E6388",
    "terminal.ansiBrightRed": "#FDA4AF",
    "terminal.ansiBrightGreen": "#6EE7B7",
    "terminal.ansiBrightYellow": "#FDE047",
    "terminal.ansiBrightBlue": "#A5B4FC",
    "terminal.ansiBrightMagenta": "#F0ABFC",
    "terminal.ansiBrightCyan": "#7DD3FC",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "chat.requestBackground": "#1A152B",
    "chat.requestBorder": "#D946EF4D",
    "chat.slashCommandBackground": "#D946EF33",
    "chat.slashCommandForeground": "#F5D0FE",
    "chat.avatarBackground": "#D946EF",
    "chat.avatarForeground": "#FFFFFF",
