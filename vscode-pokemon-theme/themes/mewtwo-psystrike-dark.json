    "statusBarItem.hoverBackground": "#D946EF2E",
    "statusBarItem.prominentBackground": "#818CF833",
    "statusBarItem.prominentForeground": "#EEF2FF",
    "statusBarItem.remoteBackground": "#D946EF",
    "statusBarItem.remoteForeground": "#FFFFFF",

    "panel.background": "#0E0B17",
