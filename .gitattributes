# Default: let Git normalize text files
* text=auto

# Windows scripts must keep CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf

# Unix shell scripts must keep LF
*.sh text eol=lf

# Binary assets
*.png binary
*.gif binary
*.webp binary
*.jpg binary
*.jpeg binary
*.ico binary
*.db binary
